---
import type { MediaCardItem } from "../../data/media";
import SectionHeading from "../ui/SectionHeading.astro";
import YouTubeVideoCard from "../ui/YouTubeVideoCard.astro";

interface Props {
  videos: MediaCardItem[];
}

const { videos } = Astro.props;
---

<section id="videos" class="space-y-8">
  <SectionHeading
    kicker="Latest Videos"
    title="Newest Videos from the Channel"
    subtitle="Fresh uploads from Gaming Discussion, Late to the Game, and Homebrew & Indie Heros, loaded at build time from YouTube."
  />

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      videos.map((video) => (
        <YouTubeVideoCard item={video} />
      ))
    }
  </div>
</section>
