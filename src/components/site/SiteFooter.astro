---
interface Props {
  brand: string;
}

const { brand } = Astro.props;
const year = new Date().getFullYear();
const youtubeChannelId = import.meta.env.YOUTUBE_CHANNEL_ID as string | undefined;
const youtubeHref = youtubeChannelId
  ? `https://www.youtube.com/channel/${youtubeChannelId}`
  : "https://www.youtube.com/@OverwhelmedGamer";
---

<footer class="footer-shell">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-7 px-5 py-10 md:px-8">
    <div>
      <p class="font-display text-lg tracking-[0.18em] text-[var(--color-text)]">{brand}</p>
      <p class="mt-2 text-sm text-[var(--color-muted)]">Creator hub for overwhelmed gamers.</p>
    </div>

    <div class="flex flex-wrap items-center gap-x-5 gap-y-3 text-xs uppercase tracking-[0.12em] text-[var(--color-muted)]">
      <a href="/" class="footer-link">Home</a>
      <a href="/podcast" class="footer-link">Podcast</a>
      <a href="/tools" class="footer-link">Tools</a>
      <a href="/merch" class="footer-link">Merch</a>
      <a href="/support" class="footer-link">Support</a>
      <a href="/contact" class="footer-link">Contact</a>
      <a href={youtubeHref} class="footer-link" target="_blank" rel="noopener noreferrer">YouTube</a>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <a
        href="https://discord.gg/KW2CRR9Uep"
        class="social-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Join on Discord"
      >
        <svg viewBox="0 0 24 24" class="social-svg" aria-hidden="true" focusable="false">
          <path d="M19.2 5.2a15.4 15.4 0 0 0-3.82-1.2l-.18.36-.21.45a13.9 13.9 0 0 0-5.98 0L8.8 4.4l-.18-.36a15.4 15.4 0 0 0-3.82 1.2C2.4 8.9 1.75 12.5 2.07 16.05a15.7 15.7 0 0 0 4.69 2.38l1-1.63c-.55-.21-1.07-.47-1.56-.78l.37-.27c3 .93 6.24.93 9.24 0 .13.1.25.19.37.27-.49.31-1.01.57-1.56.78l1 1.63a15.7 15.7 0 0 0 4.69-2.38c.38-4.12-.64-7.69-2.99-10.85ZM9.58 13.9c-.91 0-1.66-.84-1.66-1.88s.73-1.88 1.66-1.88c.93 0 1.67.84 1.66 1.88 0 1.04-.73 1.88-1.66 1.88Zm4.84 0c-.91 0-1.66-.84-1.66-1.88s.73-1.88 1.66-1.88c.93 0 1.67.84 1.66 1.88 0 1.04-.73 1.88-1.66 1.88Z" fill="currentColor"></path>
        </svg>
      </a>
      <a
        href="https://www.facebook.com/OverwhelmedGamer"
        class="social-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Follow on Facebook"
      >
        <span class="social-icon">f</span>
      </a>
      <a
        href="https://www.instagram.com/overwhelmed_gamer/"
        class="social-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Follow on Instagram"
      >
        <svg viewBox="0 0 24 24" class="social-svg" aria-hidden="true" focusable="false">
          <rect x="4" y="4" width="16" height="16" rx="4" ry="4" fill="none" stroke="currentColor" stroke-width="2"></rect>
          <circle cx="12" cy="12" r="3.8" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <circle cx="17.2" cy="6.8" r="1.2" fill="currentColor"></circle>
        </svg>
      </a>
      <a
        href="https://x.com/OverwhelmedGame"
        class="social-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Follow on X"
      >
        <span class="social-icon">X</span>
      </a>
      <a
        href="https://www.threads.com/@overwhelmed_gamer"
        class="social-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Follow on Threads"
      >
        <span class="social-icon">@</span>
      </a>
      <a
        href="https://www.tiktok.com/@overwhelmed.gamer"
        class="social-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Follow on TikTok"
      >
        <svg viewBox="0 0 24 24" class="social-svg" aria-hidden="true" focusable="false">
          <path d="M14.2 3v10.1a3.6 3.6 0 1 1-3-3.54v2.3a1.46 1.46 0 1 0 .86 1.34V3h2.14c.35 1.68 1.7 3 3.42 3.33V8.5a5.58 5.58 0 0 1-3.42-1.17V3z" fill="currentColor"></path>
        </svg>
      </a>
      <a
        href="https://bsky.app/profile/overwhelmedgamer.bsky.social"
        class="social-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Follow on Bluesky"
      >
        <svg viewBox="0 0 24 24" class="social-svg" aria-hidden="true" focusable="false">
          <path d="M12 9.2c1.3-2.1 4.2-4.2 5.7-5.2.7-.5 1.9-1 1.9.4 0 .9-.6 6.9-1 8-.5 1.4-2.1 1.8-3.6 1.5 2.6.4 3.3 1.7 1.9 3s-2.6.6-3.8-.5c-.8-.8-1.3-1.8-2.1-2.8-.8 1-1.3 2-2.1 2.8-1.2 1.1-2.4 1.8-3.8.5s-.7-2.6 1.9-3c-1.5.3-3.1-.1-3.6-1.5-.4-1.1-1-7.1-1-8 0-1.4 1.2-.9 1.9-.4 1.5 1 4.4 3.1 5.7 5.2z" fill="currentColor"></path>
        </svg>
      </a>
    </div>
  </div>
  <p class="border-t border-white/10 px-5 py-4 text-xs text-[var(--color-muted)] md:px-8">
    © {year} {brand}. All rights reserved.
  </p>
</footer>

<style>
  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, white 12%);
    color: color-mix(in srgb, var(--color-accent) 78%, white 22%);
    background: color-mix(in srgb, var(--color-bg) 82%, white 2%);
    transition: transform 160ms ease, border-color 160ms ease, color 160ms ease, background 160ms ease;
  }

  .social-link:hover,
  .social-link:focus-visible {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--color-accent) 90%, white 5%);
    color: #fff0c8;
    background: color-mix(in srgb, var(--color-accent) 20%, var(--color-bg) 80%);
  }

  .social-link:focus-visible {
    outline: none;
  }

  .social-icon {
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .social-svg {
    width: 1rem;
    height: 1rem;
  }
</style>
