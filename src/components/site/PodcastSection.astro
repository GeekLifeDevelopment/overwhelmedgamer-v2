---
import type { MediaCardItem } from "../../data/media";
import type { PromoBlock } from "../../data/site";
import SectionHeading from "../ui/SectionHeading.astro";

interface Props {
  feature: PromoBlock;
  episodes: MediaCardItem[];
}

const { feature, episodes } = Astro.props;

const featuredEpisode = episodes[0];
const previousEpisodes = episodes.slice(1, 4);

const SECTION_CUTOFF_PATTERNS = [
  /watch the video podcast/i,
  /connect with jason/i,
  /streaming/i,
  /join the community/i,
  /socials?/i,
  /don.?t forget to subscribe/i
];

function stripRawUrls(input: string): string {
  return input.replace(/(?:https?:\/\/|www\.)\S+/gi, " ");
}

function normalizeDescription(input?: string): string {
  const fallback = "New episode from The Overwhelmed Gamer podcast.";
  if (!input?.trim()) return fallback;

  let cleaned = stripRawUrls(input)
    .replace(/\s+/g, " ")
    .replace(/\s*[-|:]+\s*/g, " ")
    .trim();

  for (const pattern of SECTION_CUTOFF_PATTERNS) {
    const matchIndex = cleaned.search(pattern);
    if (matchIndex > 70) {
      cleaned = cleaned.slice(0, matchIndex).trim();
      break;
    }
  }

  return cleaned || fallback;
}

function truncateAtWord(input: string, limit: number): string {
  if (input.length <= limit) return input;

  const window = input.slice(0, limit + 1);
  const splitAt = window.lastIndexOf(" ");
  const safeCut = splitAt > Math.floor(limit * 0.6) ? splitAt : limit;

  return `${window.slice(0, safeCut).trimEnd()}…`;
}

const featuredDescription = truncateAtWord(
  normalizeDescription(featuredEpisode?.excerpt ?? featuredEpisode?.description ?? feature.description),
  200
);
---

<section id="podcast" class="space-y-6">
  <SectionHeading
    kicker="Podcast"
    title="Latest Podcast Episodes"
    subtitle="Retro gaming conversations, reviews, and deep dives."
  />

  <div class="grid gap-4 lg:grid-cols-[1.4fr_1fr] lg:items-stretch">

    <!-- Featured episode: compact horizontal layout -->
    <article class="feature-card h-full overflow-hidden">
      <div class="flex h-full flex-col gap-4 sm:flex-row sm:gap-4">

        <!-- Thumbnail -->
        {featuredEpisode ? (
          <a
            href={featuredEpisode.externalLink}
            aria-label={`Open ${featuredEpisode.title}`}
            class="block shrink-0 sm:w-52 sm:self-stretch lg:w-56"
          >
            <div class="podcast-featured-thumbnail-shell">
              <div class="media-thumbnail-wrap podcast-featured-thumbnail-wrap mb-0">
                <img
                  src={featuredEpisode.thumbnail}
                  alt={`Podcast episode thumbnail for ${featuredEpisode.title}`}
                  class="media-thumbnail podcast-featured-thumbnail"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <span class="podcast-featured-label">Latest Episode</span>
            </div>
          </a>
        ) : null}

        <!-- Content -->
        <div class="flex min-w-0 flex-1 flex-col gap-2">
          {featuredEpisode ? (
            <>
              <h3 class="line-clamp-2 font-display text-xl leading-snug text-[var(--color-text)] sm:text-2xl">
                {featuredEpisode.title}
              </h3>
              <p class="text-xs uppercase tracking-[0.13em] text-[var(--color-muted)]">
                {featuredEpisode.date} • {featuredEpisode.platform}
              </p>
              <p class="line-clamp-3 text-sm leading-relaxed text-[var(--color-muted)]">
                {featuredDescription}
              </p>
              <div class="flex flex-wrap gap-2 pt-1">
                <a href={featuredEpisode.externalLink} class="accent-button">Listen Now</a>
                <a href="/podcast" class="ghost-button">View All Episodes</a>
              </div>
            </>
          ) : (
            <>
              <h3 class="font-display text-xl text-[var(--color-text)] sm:text-2xl">{feature.title}</h3>
              <p class="text-sm leading-relaxed text-[var(--color-muted)]">{feature.description}</p>
              <div class="pt-1">
                <a href="/podcast" class="accent-button">View All Episodes</a>
              </div>
            </>
          )}
        </div>
      </div>
    </article>

    <!-- Recent episodes: compact horizontal cards -->
    <div class="flex flex-col gap-3">
      {previousEpisodes.map((episode) => (
        <article class="feature-card overflow-hidden">
          <div class="flex items-start gap-3">

            <!-- Small thumbnail -->
            <a
              href={episode.externalLink}
              aria-label={`Open ${episode.title}`}
              class="block w-24 shrink-0"
            >
              <div class="media-thumbnail-wrap mb-0">
                <img
                  src={episode.thumbnail}
                  alt=""
                  class="media-thumbnail"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </a>

            <!-- Content -->
            <div class="flex min-w-0 flex-col gap-1">
              <h3 class="line-clamp-2 font-display text-base leading-snug text-[var(--color-text)]">
                {episode.title}
              </h3>
              <p class="text-xs uppercase tracking-[0.12em] text-[var(--color-muted)]">
                {episode.date} • {episode.platform}
              </p>
              <a href={episode.externalLink} class="tool-cta self-start" style="margin-top: 0.35rem">Listen</a>
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
