---
import type { NavItem } from "../../data/site";

interface Props {
  brand: string;
  navItems: NavItem[];
}

const { brand, navItems } = Astro.props;
---

<header class="site-header">
  <div class="site-header-inner mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-4 py-4 md:px-8 md:py-5">
    <a href="/" class="font-display text-base tracking-[0.2em] text-[var(--color-text)] sm:text-lg">{brand}</a>

    <nav class="desktop-nav" aria-label="Primary">
      <ul class="flex items-center gap-2 sm:gap-5">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="nav-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <details class="mobile-nav">
      <summary class="mobile-menu-button" aria-label="Toggle navigation menu">
        <span class="mobile-menu-label">Menu</span>
        <span class="mobile-menu-icon" aria-hidden="true"></span>
      </summary>

      <nav class="mobile-menu-panel" aria-label="Mobile Primary">
        <ul class="mobile-menu-list">
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} class="mobile-nav-link">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  const mobileNav = document.querySelector(".mobile-nav");
  if (mobileNav instanceof HTMLDetailsElement) {
    const links = mobileNav.querySelectorAll("a");
    links.forEach((link) => {
      link.addEventListener("click", () => {
        mobileNav.open = false;
      });
    });
  }
</script>
