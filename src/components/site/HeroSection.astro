---
---

<section class="hero-panel">
  <div class="hero-grid">
    <div>
      <img
        src="/web-logo.png"
        alt="The Overwhelmed Gamer logo with retro controller icon"
        class="hero-mobile-logo"
        loading="eager"
        decoding="async"
      />
      <p class="section-kicker">The Overwhelmed Gamer</p>
      <h1 class="hero-title">Retro games. Homebrew gems. Backlog chaos.</h1>
      <p class="hero-copy">
         After nearly 20 years away from gaming, I'm finally experiencing the classics, hidden gems, and modern hits I missed—one playthrough at a time.
      </p>

      <div class="hero-cta-row">
        <a href="#videos" class="accent-button">Watch Latest Video</a>
        <a href="#podcast" class="ghost-button">Listen to Podcast</a>
        <!-- <a href="#collector" class="ghost-button hero-cta-highlight">Try OG Collector</a> -->
        
      </div>
    </div>

    <div class="hero-art-wrap" aria-hidden="true">
      <img src="/web-logo.png" alt="" class="hero-art-main" loading="eager" decoding="async" />
    </div>
  </div>
</section>
