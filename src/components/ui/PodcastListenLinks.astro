---
import { PodcastListenButton } from "./PodcastListenButton";
import type { MediaCardItem } from "../../data/media";

interface Props {
  episode: MediaCardItem;
  bare?: boolean;
}

const { episode, bare = false } = Astro.props;
const platformLinks = episode.links || {};

// Define platform order and metadata
const platforms = [
  { key: "spotify" as const, label: "Spotify" },
  { key: "apple" as const, label: "Apple Podcasts" },
  { key: "youtube" as const, label: "YouTube" },
  { key: "rss" as const, label: "RSS Feed" }
];

// Filter to only platforms with URLs
const availablePlatforms = platforms.filter((p) => platformLinks[p.key]);

// If no platforms have URLs, don't render anything
if (availablePlatforms.length === 0) {
  // Could optionally render an empty state message here
  // For now, we'll render nothing
}
---

{
  availablePlatforms.length > 0 && (
    bare ? (
      <div class="space-y-3">
        <p class="text-sm text-[var(--color-muted)]">Subscribe on your favorite platform.</p>
        <div class="flex flex-wrap gap-2.5">
          {availablePlatforms.map((platform) => (
            <PodcastListenButton
              client:load
              platform={platform.key}
              url={platformLinks[platform.key] || ""}
            />
          ))}
        </div>
      </div>
    ) : (
      <section class="feature-card podcast-listen-card space-y-3">
        <div>
          <p class="section-kicker">Listen On</p>
          <p class="text-sm text-[var(--color-muted)]">Subscribe on your favorite platform.</p>
        </div>
        <div class="flex flex-wrap gap-2.5">
          {availablePlatforms.map((platform) => (
            <PodcastListenButton
              client:load
              platform={platform.key}
              url={platformLinks[platform.key] || ""}
            />
          ))}
        </div>
      </section>
    )
  )
}
