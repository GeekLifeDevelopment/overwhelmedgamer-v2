---
import type { MediaCardItem } from "../../data/media";

interface Props {
  item: MediaCardItem;
  label: string;
  ariaPrefix: string;
}

const { item, label, ariaPrefix } = Astro.props;

const TRUNCATE_LENGTH = 120;
const desc = item.description ?? "";
const isLong = desc.length > TRUNCATE_LENGTH;
const shortDesc = isLong ? desc.slice(0, TRUNCATE_LENGTH).trimEnd() + "…" : desc;
---

<a
  href={item.externalLink}
  class="media-card"
  aria-label={`${ariaPrefix} ${item.title}`}
  target="_blank"
  rel="noopener noreferrer"
>
  <div class="media-thumbnail-wrap">
    <img src={item.thumbnail} alt="" class="media-thumbnail" loading="lazy" decoding="async" />
    <span class="media-label">{label}</span>
  </div>

  <h3 class="font-display text-xl text-[var(--color-text)]">{item.title}</h3>

  {isLong ? (
    <details class="mt-2 text-sm leading-relaxed text-[var(--color-muted)]">
      <summary class="cursor-pointer list-none">
        <span class="description-preview">{shortDesc}</span>
        <span class="read-more-link"> Read more</span>
        <span class="read-less-link"> Read less</span>
      </summary>
      <p class="mt-1">{desc}</p>
    </details>
  ) : (
    <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted)]">{desc}</p>
  )}

  <p class="mt-3 text-xs uppercase tracking-[0.13em] text-[var(--color-muted)]">
    {item.date} • {item.platform}
  </p>
</a>

<style>
  details[open] .read-more-link {
    display: none;
  }
  details:not([open]) .read-less-link {
    display: none;
  }
  .read-more-link {
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .read-less-link {
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .description-preview {
    display: inline;
  }
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
