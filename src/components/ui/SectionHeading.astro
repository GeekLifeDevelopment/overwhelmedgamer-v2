---
interface Props {
  kicker: string;
  title: string;
  subtitle: string;
}

const { kicker, title, subtitle } = Astro.props;
---

<div class="space-y-3">
  <p class="section-kicker">{kicker}</p>
  <h2 class="font-display text-3xl tracking-wide text-[var(--color-text)] sm:text-4xl">{title}</h2>
  <p class="max-w-2xl text-base leading-relaxed text-[var(--color-muted)]">{subtitle}</p>
</div>
