---
import SiteFooter from "../components/site/SiteFooter.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { navItems, siteMeta } from "../data/site";

const siteUrl =
  (import.meta.env.PUBLIC_SITE_URL as string | undefined)?.replace(/\/$/, "") ||
  "https://www.theoverwhelmedgamer.com";

const supportPageUrl = `${siteUrl}/support`;
const supportTitle = "Support The Overwhelmed Gamer";
const supportDescription =
  "Join the community, help shape future content, and support retro gaming reviews, podcasts, livestreams, and homebrew discoveries.";

const supportOptions = [
  {
    title: "Patreon",
    description:
      "Join through Patreon to become a Community Supporter and unlock private Discord access, member polls, game suggestions, podcast opportunities, and more. Starting at $1/month.",
    ctaLabel: "Join on Patreon",
    href: "https://www.patreon.com/c/overwhelmedgamer/membership"
  },
  {
    title: "YouTube Membership",
    description:
      "Support directly on YouTube and get Community Supporter benefits while helping keep videos, podcasts, and streams coming.",
    ctaLabel: "Join on YouTube",
    href: "https://www.youtube.com/channel/UCU5yHwDYrLbAPI2UuAOV0lw/join"
  },
  {
    title: "Facebook Subscription",
    description:
      "Subscribe on Facebook to support the channel and connect with the same member-focused community experience.",
    ctaLabel: "Subscribe on Facebook",
    href: "https://www.facebook.com/OverwhelmedGamer/subscribe/"
  }
];
---

<BaseLayout
  title={`${supportTitle} | The Overwhelmed Gamer`}
  description={supportDescription}
  canonicalUrl={supportPageUrl}
  ogType="website"
  ogTitle={supportTitle}
  ogDescription={supportDescription}
  ogImage="/web-logo.png"
>
  <SiteHeader brand={siteMeta.title} navItems={navItems} />

  <main class="mx-auto flex w-full max-w-5xl flex-col gap-8 px-5 pb-16 pt-8 md:gap-10 md:px-8 md:pt-10">
    <section class="hero-panel space-y-4" aria-labelledby="support-page-title">
      <p class="section-kicker">Community Supporter</p>
      <h1 id="support-page-title" class="hero-title">Support The Overwhelmed Gamer</h1>
      <p class="hero-copy max-w-3xl">{supportDescription}</p>
    </section>

    <section class="feature-card space-y-5" aria-labelledby="support-tier-title">
      <div class="space-y-2">
        <h2 id="support-tier-title" class="font-display text-2xl text-[var(--color-text)] sm:text-3xl">
          Community Supporter
        </h2>
        <p class="platform-summary text-sm leading-relaxed text-[var(--color-muted)]">
          Join through Patreon, YouTube, Facebook, or Twitch and receive the same Community
          Supporter benefits.
        </p>
        <div class="platform-links" aria-label="Community Supporter platforms">
          <a
            href="https://www.patreon.com/c/overwhelmedgamer/membership"
            class="platform-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Join Community Supporter through Patreon"
          >
            <span class="platform-dot" aria-hidden="true">P</span>Patreon
          </a>
          <a
            href="https://www.youtube.com/channel/UCU5yHwDYrLbAPI2UuAOV0lw/join"
            class="platform-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Join Community Supporter through YouTube"
          >
            <span class="platform-dot" aria-hidden="true">Y</span>YouTube
          </a>
          <a
            href="https://www.facebook.com/OverwhelmedGamer/subscribe/"
            class="platform-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Join Community Supporter through Facebook"
          >
            <span class="platform-dot" aria-hidden="true">F</span>Facebook
          </a>
          <a
            href="https://www.twitch.tv/theoverwhelmedgamer"
            class="platform-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Join Community Supporter through Twitch"
          >
            <span class="platform-dot" aria-hidden="true">T</span>Twitch
          </a>
        </div>
        <p class="text-sm leading-relaxed text-[var(--color-muted)] sm:text-base">
          Become a Community Supporter and get access to the private Discord, member polls, game
          suggestion opportunities, podcast questions and shout-outs, behind-the-scenes updates, and
          the chance to be invited onto future podcast episodes as a guest panelist.
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        {
          supportOptions.map((option) => (
            <article class="support-option-card">
              <h3 class="font-display text-xl text-[var(--color-text)]">{option.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted)]">{option.description}</p>
              <a
                href={option.href}
                class="accent-button mt-4 w-full justify-center"
                target="_blank"
                rel="noopener noreferrer"
              >
                {option.ctaLabel}
              </a>
            </article>
          ))
        }
      </div>

      <div class="support-note space-y-2">
        <p class="text-sm text-[var(--color-muted)]">
          No matter where you subscribe&mdash;Patreon, YouTube, Facebook, or Twitch&mdash;you'll receive access
          to the same Community Supporter community, including private Discord access, member polls,
          game suggestions, podcast participation opportunities, and community perks.
        </p>
        <p class="text-sm text-[var(--color-muted)]">
          Twitch subscribers can request Community Supporter access through Discord and receive the
          same community benefits.
        </p>
        <a
          href="https://www.twitch.tv/theoverwhelmedgamer"
          class="twitch-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Stream with us on Twitch"
        >
          Stream with us on Twitch
        </a>
      </div>
    </section>
  </main>

  <SiteFooter brand={siteMeta.title} />
</BaseLayout>

<style>
  .support-option-card {
    border: 1px solid var(--color-border);
    border-radius: 0.95rem;
    background: linear-gradient(155deg, rgba(255, 255, 255, 0.015), rgba(255, 122, 0, 0.06));
    padding: 1rem;
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
    display: flex;
    flex-direction: column;
  }

  .support-option-card:hover,
  .support-option-card:focus-within {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-accent) 58%, var(--color-border));
    box-shadow: 0 10px 24px rgba(255, 122, 0, 0.15);
  }

  .support-note {
    border-top: 1px solid color-mix(in srgb, var(--color-accent) 26%, var(--color-border));
    padding-top: 0.9rem;
  }

  .platform-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.7rem;
    align-items: center;
  }

  .platform-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-muted);
    font-size: 0.84rem;
    transition: color 150ms ease;
  }

  .platform-link:hover,
  .platform-link:focus-visible {
    color: var(--color-accent);
  }

  .platform-link:not(:last-child)::after {
    content: "•";
    margin-left: 0.35rem;
    color: color-mix(in srgb, var(--color-accent) 58%, var(--color-muted));
  }

  .platform-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.05rem;
    height: 1.05rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 42%, var(--color-border));
    background: color-mix(in srgb, var(--color-bg) 88%, white 3%);
    color: color-mix(in srgb, var(--color-accent) 78%, white 22%);
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1;
  }

  .twitch-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.82rem;
    color: color-mix(in srgb, var(--color-accent) 78%, white 18%);
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, var(--color-border));
    border-radius: 999px;
    padding: 0.32rem 0.7rem;
    width: fit-content;
    transition: color 150ms ease, border-color 150ms ease, background 150ms ease;
  }

  .twitch-link:hover,
  .twitch-link:focus-visible {
    color: #fff0c8;
    border-color: color-mix(in srgb, var(--color-accent) 62%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 12%, var(--color-bg) 88%);
  }

  @media (max-width: 640px) {
    .platform-summary,
    .platform-link,
    .twitch-link {
      font-size: 0.8rem;
    }
  }
</style>