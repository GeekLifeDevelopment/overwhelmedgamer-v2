---
import SiteFooter from "../components/site/SiteFooter.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { navItems, siteMeta } from "../data/site";
import { getMerchProducts, SHOP_URL } from "../lib/fourthwall";

const products = await getMerchProducts();
---

<BaseLayout
  title="Overwhelmed Gamer Merch"
  description="Shop official Overwhelmed Gamer merch and support retro gaming videos, podcasts, livestreams, and backlog-focused content."
>
  <SiteHeader brand={siteMeta.title} navItems={navItems} />

  <main class="mx-auto flex w-full max-w-5xl flex-col gap-8 px-5 pb-16 pt-8 md:gap-10 md:px-8 md:pt-10">
    <!-- Hero Section -->
    <section class="hero-panel">
      <div class="grid gap-6 md:grid-cols-[1.1fr_0.9fr] md:items-center">
        <div class="space-y-4">
          <p class="section-kicker">Official Store</p>
          <h1 class="hero-title">Overwhelmed Gamer Merch</h1>
          <p class="hero-copy">
            Rep the backlog with shirts, gear, and creator merch from The Overwhelmed Gamer.
          </p>
          <p class="text-sm leading-relaxed text-[var(--color-muted)]">
            Grab official Overwhelmed Gamer merch and support the channel, podcast, livestreams, and retro gaming content.
          </p>
          <div class="hero-cta-row !mt-3">
            <a
              href={SHOP_URL}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Shop all Overwhelmed Gamer merch on Fourthwall"
              class="accent-button"
            >
              Shop All Merch
            </a>
          </div>
        </div>

        <div class="hero-art-wrap" aria-hidden="true">
          <img src="/web-logo.png" alt="" class="hero-art-main" loading="eager" decoding="async" />
        </div>
      </div>
    </section>

    <!-- Featured Products Grid -->
    <section class="space-y-6">
      <div class="flex items-center justify-between gap-3">
        <div>
          <p class="section-kicker">Featured Products</p>
          <h2 class="font-display text-2xl text-[var(--color-text)] mt-1">Pick Your Gear</h2>
        </div>
        <a
          href={SHOP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="tool-cta shrink-0"
        >
          View Full Store
        </a>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {products.length === 0 ? (
          <p class="col-span-full text-center text-[var(--color-muted)] py-12">
            Products coming soon — visit the{" "}
            <a href={SHOP_URL} target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">
              Fourthwall store
            </a>{" "}
            to shop now.
          </p>
        ) : (
          products.map((item) => (
            <article class="merch-card">
              <div class="merch-image-wrap">
                <img
                  src={item.imageUrl}
                  alt={item.title}
                  class="merch-image"
                  loading="lazy"
                  decoding="async"
                />
                {!item.available ? (
                  <span class="merch-badge">Unavailable</span>
                ) : null}
              </div>

              <div class="merch-card-body">
                <h3 class="font-display text-lg text-[var(--color-text)]">{item.title}</h3>
                {item.price ? (
                  <p class="mt-2 font-display text-base text-[var(--color-accent)]">{item.price}</p>
                ) : null}
                <a
                  href={item.productUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`View ${item.title} on Fourthwall`}
                  class="tool-cta mt-3 inline-flex"
                >
                  Buy on Fourthwall
                </a>
              </div>
            </article>
          ))
        )}
      </div>
    </section>

    <!-- Shop All CTA -->
    <section class="feature-card text-center space-y-4">
      <p class="section-kicker">More in the Store</p>
      <h2 class="font-display text-2xl text-[var(--color-text)]">See Everything in the Shop</h2>
      <p class="text-[var(--color-muted)] leading-relaxed max-w-lg mx-auto">
        Browse all available products, limited drops, and new arrivals on the Fourthwall storefront. Purchases go directly toward supporting retro gaming content.
      </p>
      <a
        href={SHOP_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Browse the full Overwhelmed Gamer store on Fourthwall"
        class="accent-button inline-flex"
      >
        Shop All Merch
      </a>
    </section>
  </main>

  <SiteFooter brand={siteMeta.title} />
</BaseLayout>

<style>
  .merch-card {
    border: 1px solid var(--color-border);
    border-radius: 0.95rem;
    background: linear-gradient(155deg, rgba(255, 255, 255, 0.015), rgba(255, 122, 0, 0.05));
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .merch-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-accent) 58%, var(--color-border));
    box-shadow: 0 10px 24px rgba(255, 122, 0, 0.15);
  }

  .merch-image-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    background:
      linear-gradient(145deg, rgba(255, 180, 0, 0.14), rgba(255, 122, 0, 0.22)),
      linear-gradient(45deg, #1b1b1b, #0f0f0f);
    overflow: hidden;
  }

  .merch-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1rem;
    filter: saturate(0.85) contrast(1.05);
  }

  .merch-badge {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 180, 0, 0.45);
    padding: 0.2rem 0.62rem;
    font-size: 0.69rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffd271;
    background: rgba(0, 0, 0, 0.72);
  }

  .merch-card-body {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
</style>
