---
import SiteFooter from "../components/site/SiteFooter.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { navItems, siteMeta } from "../data/site";
import { getMerchProducts, SHOP_URL } from "../lib/fourthwall";

const products = await getMerchProducts();

const siteUrl =
  (import.meta.env.PUBLIC_SITE_URL as string | undefined)?.replace(/\/$/, "") ||
  "https://www.theoverwhelmedgamer.com";
const merchUrl = `${siteUrl}/merch`;
const merchMetaTitle = "Official Overwhelmed Gamer Merch & Retro Gaming Apparel";
const merchMetaDescription =
  "Rep the backlog and support the channel with official Overwhelmed Gamer merch: retro gaming shirts, funny gamer tees, and new apparel drops.";
const featuredOgImage = products[0]?.imageUrl || `${siteUrl}/web-logo.png`;

const productAltText = (title: string): string => {
  const lower = title.toLowerCase();
  if (lower.includes("snake")) {
    return "Black retro gaming t-shirt featuring Snake?! Snake?! SNAKE!!! red alert style design";
  }
  if (lower.includes("hey! listen")) {
    return "Retro gamer graphic tee with Hey! Listen! quote inspired by classic fantasy adventure games";
  }
  if (lower.includes("nes") || lower.includes("classic nes")) {
    return "Minimalist retro gaming shirt with classic NES inspired quote design";
  }
  if (lower.includes("save states")) {
    return "Funny retro gamer humor shirt with Save States Older Than You slogan";
  }
  return `${title}, official Overwhelmed Gamer retro gaming apparel`;
};

const productSchema = products.slice(0, 8).map((item) => {
  const hasPriceRange =
    typeof item.minPrice === "number" &&
    typeof item.maxPrice === "number" &&
    item.maxPrice > item.minPrice;
  const currency = item.currency || "USD";

  return {
    "@context": "https://schema.org",
    "@type": "Product",
    name: item.title,
    image: [item.imageUrl],
    description: item.description || `${item.title} from the official Overwhelmed Gamer merch collection.`,
    sku: item.sku || `SKU-${item.slug.toUpperCase()}`,
    brand: {
      "@type": "Brand",
      name: "The Overwhelmed Gamer"
    },
    offers: hasPriceRange
      ? {
          "@type": "AggregateOffer",
          priceCurrency: currency,
          lowPrice: item.minPrice?.toFixed(2),
          highPrice: item.maxPrice?.toFixed(2),
          offerCount: 2,
          availability: item.available ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
          url: item.productUrl
        }
      : {
          "@type": "Offer",
          priceCurrency: currency,
          price: (item.minPrice ?? 0).toFixed(2),
          availability: item.available ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
          url: item.productUrl
        }
  };
});
---

<BaseLayout
  title={merchMetaTitle}
  description={merchMetaDescription}
  canonicalUrl={merchUrl}
  ogType="website"
  ogTitle={merchMetaTitle}
  ogDescription="Official Overwhelmed Gamer merch and retro gaming apparel. Rep the backlog and support the channel."
  ogImage={featuredOgImage}
  jsonLd={productSchema}
>
  <SiteHeader brand={siteMeta.title} navItems={navItems} />

  <main class="mx-auto flex w-full max-w-5xl flex-col gap-8 px-5 pb-16 pt-8 md:gap-10 md:px-8 md:pt-10">
    <!-- Hero Section -->
    <section class="hero-panel">
      <div class="grid gap-6 md:grid-cols-[1.1fr_0.9fr] md:items-center">
        <div class="space-y-4">
          <p class="section-kicker">Official Store</p>
          <h1 class="hero-title">Overwhelmed Gamer Merch</h1>
          <p class="hero-copy">
            Rep the backlog with shirts, gear, and creator merch from The Overwhelmed Gamer.
          </p>
          <p class="text-sm leading-relaxed text-[var(--color-muted)]">
            Grab official Overwhelmed Gamer merch and support the channel, podcast, livestreams, and retro gaming content.
          </p>
          <div class="hero-cta-row !mt-3">
            <a
              href={SHOP_URL}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Shop all Overwhelmed Gamer merch on Fourthwall"
              class="accent-button"
            >
              Shop All Merch
            </a>
          </div>
        </div>

        <div class="hero-art-wrap">
          <img
            src="/web-logo.png"
            alt="Overwhelmed Gamer controller logo for the official retro gaming merch store"
            class="hero-art-main"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <!-- Featured Products Grid -->
    <section class="space-y-6">
      <div class="flex items-center justify-between gap-3">
        <div>
          <p class="section-kicker">Featured Products</p>
          <h2 class="font-display text-2xl text-[var(--color-text)] mt-1">Pick Your Gear</h2>
        </div>
        <a
          href={SHOP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="tool-cta shrink-0"
        >
          View Full Store
        </a>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {products.length === 0 ? (
          <p class="col-span-full text-center text-[var(--color-muted)] py-12">
            Products coming soon — visit the{" "}
            <a href={SHOP_URL} target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">
              Fourthwall store
            </a>{" "}
            to shop now.
          </p>
        ) : (
          products.map((item) => (
            <article class="merch-card">
              <div class="merch-image-wrap">
                <img
                  src={item.imageUrl}
                  alt={productAltText(item.title)}
                  class="merch-image"
                  loading="lazy"
                  decoding="async"
                />
                {!item.available ? (
                  <span class="merch-badge">Unavailable</span>
                ) : null}
              </div>

              <div class="merch-card-body">
                <h3 class="font-display text-lg text-[var(--color-text)]">{item.title}</h3>
                {item.price ? (
                  <p class="mt-2 font-display text-base text-[var(--color-accent)]">{item.price}</p>
                ) : null}
                <a
                  href={item.productUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`View ${item.title} on Fourthwall`}
                  class="tool-cta mt-3 inline-flex"
                >
                  Buy on Fourthwall
                </a>
              </div>
            </article>
          ))
        )}
      </div>
    </section>

    <!-- Shop All CTA -->
    <section class="feature-card text-center space-y-4">
      <p class="section-kicker">More in the Store</p>
      <h2 class="font-display text-2xl text-[var(--color-text)]">See Everything in the Shop</h2>
      <p class="text-[var(--color-muted)] leading-relaxed max-w-lg mx-auto">
        Browse all available products, limited drops, and new arrivals on the Fourthwall storefront. Purchases go directly toward supporting retro gaming content.
      </p>
      <a
        href={SHOP_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Browse the full Overwhelmed Gamer store on Fourthwall"
        class="accent-button inline-flex"
      >
        Shop All Merch
      </a>
    </section>
  </main>

  <SiteFooter brand={siteMeta.title} />
</BaseLayout>

<style>
  .merch-card {
    border: 1px solid var(--color-border);
    border-radius: 0.95rem;
    background: linear-gradient(155deg, rgba(255, 255, 255, 0.015), rgba(255, 122, 0, 0.05));
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .merch-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-accent) 58%, var(--color-border));
    box-shadow: 0 10px 24px rgba(255, 122, 0, 0.15);
  }

  .merch-image-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    background:
      linear-gradient(145deg, rgba(255, 180, 0, 0.14), rgba(255, 122, 0, 0.22)),
      linear-gradient(45deg, #1b1b1b, #0f0f0f);
    overflow: hidden;
  }

  .merch-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1rem;
    filter: saturate(0.85) contrast(1.05);
  }

  .merch-badge {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 180, 0, 0.45);
    padding: 0.2rem 0.62rem;
    font-size: 0.69rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffd271;
    background: rgba(0, 0, 0, 0.72);
  }

  .merch-card-body {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
</style>
