---
import CommunitySupportSection from "../components/site/CommunitySupportSection.astro";
import GamingToolsSection from "../components/site/GamingToolsSection.astro";
import HeroSection from "../components/site/HeroSection.astro";
import LivestreamSection from "../components/site/LivestreamSection.astro";
import MerchSection from "../components/site/MerchSection.astro";
import OgCollectorSection from "../components/site/OgCollectorSection.astro";
import PodcastSection from "../components/site/PodcastSection.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import VideoSection from "../components/site/VideoSection.astro";
import {
	latestPodcastEpisodes,
	latestYouTubeVideos as fallbackVideos,
	recentLivestreams
} from "../data/media";
import {
  gamingTools,
  navItems,
  ogCollectorPromo,
  podcastFeature,
	siteMeta
} from "../data/site";
import { getMerchProducts } from "../lib/fourthwall";
import { getLatestLivestreams, getLatestVideos } from "../lib/youtube";
import { getLatestPodcastEpisodes } from "../lib/podcast";
import BaseLayout from "../layouts/BaseLayout.astro";

const SECTION_CARD_LIMIT = 3;

const fetchedVideos = await getLatestVideos(SECTION_CARD_LIMIT);
const latestVideos = (fetchedVideos.length > 0 ? fetchedVideos : fallbackVideos).slice(
	0,
	SECTION_CARD_LIMIT
);

const fetchedStreams = await getLatestLivestreams(SECTION_CARD_LIMIT);
const latestStreams = (fetchedStreams.length > 0 ? fetchedStreams : recentLivestreams).slice(
	0,
	SECTION_CARD_LIMIT
);
const fetchedEpisodes = await getLatestPodcastEpisodes(SECTION_CARD_LIMIT);
const latestEpisodes = (fetchedEpisodes.length > 0 ? fetchedEpisodes : latestPodcastEpisodes).slice(
	0,
	SECTION_CARD_LIMIT
);

const featuredMerch = await getMerchProducts(SECTION_CARD_LIMIT);

const siteUrl =
	(import.meta.env.PUBLIC_SITE_URL as string | undefined)?.replace(/\/$/, "") ||
	"https://www.theoverwhelmedgamer.com";

const homeTitle = "The Overwhelmed Gamer | Retro Reviews & Backlog";
const homeDescription =
	"Retro game reviews, homebrew gems, and backlog-saving picks. Watch videos, catch live streams, and hear The Overwhelmed Gamer podcast.";
const homeCanonical = `${siteUrl}/`;
const homeOgImage = `${siteUrl}/web-logo.png`;

const parseIsoDate = (value: string): string => {
	const parsed = new Date(value);
	if (Number.isNaN(parsed.getTime())) {
		return new Date().toISOString();
	}
	return parsed.toISOString();
};

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "The Overwhelmed Gamer",
	url: homeCanonical,
	description:
		"Retro gaming reviews, homebrew discoveries, and backlog management content.",
	potentialAction: {
		"@type": "SearchAction",
		target: `${siteUrl}/tools?query={search_term_string}`,
		"query-input": "required name=search_term_string"
	}
};

const reviewVideosSchema = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	name: "Newest Review Videos",
	itemListOrder: "https://schema.org/ItemListOrderDescending",
	numberOfItems: latestVideos.length,
	itemListElement: latestVideos.map((video, index) => ({
		"@type": "VideoObject",
		position: index + 1,
		name: video.title,
		description: video.description,
		thumbnailUrl: `${siteUrl}${video.thumbnail}`,
		uploadDate: parseIsoDate(video.date),
		contentUrl: video.externalLink,
		embedUrl: video.externalLink,
		publisher: {
			"@type": "Organization",
			name: "The Overwhelmed Gamer",
			logo: {
				"@type": "ImageObject",
				url: `${siteUrl}/web-logo-100.png`
			}
		}
	}))
};
---

<BaseLayout
	title={homeTitle}
	description={homeDescription}
	canonicalUrl={homeCanonical}
	ogTitle={homeTitle}
	ogDescription={homeDescription}
	ogImage={homeOgImage}
	jsonLd={[websiteSchema, reviewVideosSchema]}
>
	<SiteHeader brand={siteMeta.title} navItems={navItems} />

	<main class="mx-auto flex w-full max-w-6xl flex-col gap-16 px-5 pb-20 pt-8 md:px-8 md:pt-10">
		<div class="space-y-8">
			<HeroSection />
			<CommunitySupportSection />
		</div>

		<PodcastSection feature={podcastFeature} episodes={latestEpisodes} />
		<VideoSection videos={latestVideos} />
		<LivestreamSection streams={latestStreams} />
		<MerchSection items={featuredMerch} />
		<GamingToolsSection tools={gamingTools} />
		<OgCollectorSection promo={ogCollectorPromo} />
	</main>

	<SiteFooter brand={siteMeta.title} />
</BaseLayout>
