---
import SiteFooter from "../components/site/SiteFooter.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { navItems, siteMeta } from "../data/site";

const tools = [
  {
    title: "OG Collector",
    badge: "Collection Tracker",
    description:
      "Track your video game collection, backlog, wishlist, and selling notes in one place. Built for collectors who want a cleaner way to manage what they own and what they still want to play.",
    href: "https://ogcollector.space",
    cta: "Open OG Collector",
    external: true,
  },
  {
    title: "Game Price Checker",
    badge: "Public Tool",
    description:
      "Quickly check the current value of a game without needing to create an account. Useful for pickups, trades, collection decisions, and figuring out whether a deal is worth grabbing.",
    href: "https://ogcollector.space/price-check",
    cta: "Check Game Prices",
    external: true,
  },
];

const comingSoon = [
  {
    title: "Random Game Picker",
    description:
      "Find something to play based on system, genre, mood, or collection size.",
  },
  {
    title: "Stream Idea Generator",
    description:
      "Get quick ideas for retro streams, challenge runs, and themed gaming nights.",
  },
  {
    title: "Backlog Roulette",
    description:
      "Let fate pick the next game from your never-ending backlog.",
  },
];
---

<BaseLayout
  title="Retro Gaming Tools | The Overwhelmed Gamer"
  description="Explore tools from The Overwhelmed Gamer for retro game collectors, backlog players, streamers, and homebrew fans, including OG Collector and the public game price checker."
>
  <SiteHeader brand={siteMeta.title} navItems={navItems} />

  <main class="mx-auto flex w-full max-w-5xl flex-col gap-10 px-5 pb-16 pt-8 md:gap-14 md:px-8 md:pt-10">

    <!-- Hero -->
    <section class="hero-panel">
      <div class="grid gap-6 md:grid-cols-[1.1fr_0.9fr] md:items-center">
        <div class="space-y-4">
          <p class="section-kicker">Tools for Retro Gamers</p>
          <h1 class="hero-title">Useful tools for collectors, streamers, and backlog players.</h1>
          <p class="hero-copy">
            I'm building simple tools to help retro gamers decide what to play, track what they own, check game values, and get more out of their collection. More tools are coming soon.
          </p>
          <div class="hero-cta-row !mt-3">
            <a href="#tools" class="accent-button">Explore Tools</a>
            <a href="/contact" class="ghost-button">Suggest a Tool</a>
          </div>
        </div>
        <div class="hero-art-wrap" aria-hidden="true">
          <img src="/web-logo.png" alt="" class="hero-art-main" loading="eager" decoding="async" />
        </div>
      </div>
    </section>

    <!-- Active Tool Cards -->
    <section id="tools" class="space-y-6">
      <div>
        <p class="section-kicker">Live Tools</p>
        <h2 class="font-display text-2xl text-[var(--color-text)] mt-1">Available Now</h2>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        {tools.map((tool) => (
          <article class="tool-card">
            <div class="tool-card-body">
              <span class="tool-badge">{tool.badge}</span>
              <h3 class="mt-3 font-display text-xl text-[var(--color-text)]">{tool.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted)]">{tool.description}</p>
            </div>
            <div class="tool-card-footer">
              <a
                href={tool.href}
                target={tool.external ? "_blank" : undefined}
                rel={tool.external ? "noopener noreferrer" : undefined}
                aria-label={`${tool.cta} — opens in a new tab`}
                class="accent-button w-full text-center"
              >
                {tool.cta}
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Coming Soon -->
    <section class="space-y-6">
      <div class="feature-card space-y-3 text-center">
        <p class="section-kicker">On the Roadmap</p>
        <h2 class="font-display text-2xl text-[var(--color-text)]">More tools are on the way.</h2>
        <p class="text-[var(--color-muted)] leading-relaxed max-w-xl mx-auto">
          I'm planning more lightweight tools for retro gamers, homebrew fans, and streamers — things like random game pickers, backlog helpers, stream idea generators, and collection-focused utilities.
        </p>
        <a
          href="/contact"
          class="ghost-button inline-flex"
          aria-label="Send a tool suggestion via the contact page"
        >
          Have an idea? Send it over
        </a>
      </div>

      <div class="grid gap-4 sm:grid-cols-3">
        {comingSoon.map((item) => (
          <div class="coming-soon-card" aria-label={`${item.title} — coming soon`}>
            <div class="coming-soon-badge">Coming Soon</div>
            <h3 class="mt-3 font-display text-base text-[var(--color-text)] opacity-60">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted)] opacity-60">{item.description}</p>
          </div>
        ))}
      </div>
    </section>

  </main>

  <SiteFooter brand={siteMeta.title} />
</BaseLayout>

<style>
  /* ── Active tool card ─────────────────────────────────────────── */
  .tool-card {
    border: 1px solid var(--color-border);
    border-radius: 0.95rem;
    background: linear-gradient(155deg, rgba(255, 255, 255, 0.015), rgba(255, 122, 0, 0.06));
    display: flex;
    flex-direction: column;
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .tool-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-border));
    box-shadow: 0 10px 28px rgba(255, 122, 0, 0.14);
  }

  .tool-card-body {
    padding: 1.5rem 1.5rem 1rem;
    flex: 1;
  }

  .tool-card-footer {
    padding: 0 1.5rem 1.5rem;
  }

  .tool-badge {
    display: inline-block;
    border-radius: 999px;
    border: 1px solid rgba(255, 180, 0, 0.4);
    background: rgba(0, 0, 0, 0.55);
    padding: 0.2rem 0.65rem;
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffd271;
  }

  /* ── Coming soon card ─────────────────────────────────────────── */
  .coming-soon-card {
    border: 1px solid var(--color-border);
    border-radius: 0.95rem;
    background: rgba(255, 255, 255, 0.01);
    padding: 1.25rem;
    cursor: default;
    position: relative;
    overflow: hidden;
  }

  .coming-soon-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 6px,
      rgba(255, 255, 255, 0.015) 6px,
      rgba(255, 255, 255, 0.015) 12px
    );
    pointer-events: none;
  }

  .coming-soon-badge {
    display: inline-block;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(0, 0, 0, 0.4);
    padding: 0.2rem 0.65rem;
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
  }
</style>
