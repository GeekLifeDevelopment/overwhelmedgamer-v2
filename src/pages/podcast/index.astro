---
import SiteFooter from "../../components/site/SiteFooter.astro";
import SiteHeader from "../../components/site/SiteHeader.astro";
import PodcastEpisodeCard from "../../components/ui/PodcastEpisodeCard.astro";
import PodcastListenLinks from "../../components/ui/PodcastListenLinks.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { latestPodcastEpisodes as fallbackPodcastEpisodes } from "../../data/media";
import { navItems, podcastFeature, siteMeta } from "../../data/site";
import { getLatestPodcastEpisodes } from "../../lib/podcast";

const SECTION_CARD_LIMIT = 12;
const fetchedEpisodes = await getLatestPodcastEpisodes(SECTION_CARD_LIMIT);
const episodes = (fetchedEpisodes.length > 0 ? fetchedEpisodes : fallbackPodcastEpisodes).slice(0, SECTION_CARD_LIMIT);
const featuredEpisode = episodes[0] ?? fallbackPodcastEpisodes[0];

const siteUrl =
  (import.meta.env.PUBLIC_SITE_URL as string | undefined)?.replace(/\/$/, "") ||
  "https://www.theoverwhelmedgamer.com";
const podcastPageUrl = `${siteUrl}/podcast`;
const podcastMetaTitle = "Retro Gaming Podcast | The Overwhelmed Gamer";
const podcastMetaDescription =
  "Explore The Overwhelmed Gamer retro gaming podcast with deep dives on classics, Sega eras, and NES homebrew gems like Malasombra and Anguna.";

const toAbsoluteUrl = (value?: string): string => {
  if (!value) return podcastPageUrl;
  return value.startsWith("http") ? value : `${siteUrl}${value.startsWith("/") ? value : `/${value}`}`;
};

const featuredImageUrl = toAbsoluteUrl(featuredEpisode.thumbnail);
const featuredEpisodeUrl = toAbsoluteUrl(featuredEpisode.externalLink);
const featuredThumbnailAlt = /rygar/i.test(featuredEpisode.title)
  ? "Rygar on NES featured podcast episode thumbnail with retro action artwork"
  : `Featured podcast episode thumbnail for ${featuredEpisode.title}`;

const buildPodcastEpisodeSchema = (episode: (typeof episodes)[number]) => ({
  "@type": "PodcastEpisode",
  name: episode.title,
  url: toAbsoluteUrl(episode.externalLink),
  datePublished: episode.date,
  description: episode.excerpt ?? episode.summary ?? episode.description,
  timeRequired: "PT45M",
  associatedMedia: {
    "@type": "MediaObject",
    contentUrl: episode.audioUrl ?? toAbsoluteUrl(episode.sourceLink ?? episode.externalLink)
  },
  image: toAbsoluteUrl(episode.thumbnail)
});

const podcastSeriesSchema = {
  "@context": "https://schema.org",
  "@type": "PodcastSeries",
  name: "The Overwhelmed Gamer Podcast",
  description:
    "Retro gaming podcast covering deep dives into classics, homebrew gems, and practical backlog management.",
  url: podcastPageUrl,
  about: [
    { "@type": "Thing", name: "Retro game reviews" },
    { "@type": "Thing", name: "Homebrew games" },
    { "@type": "Thing", name: "Gaming backlog management" },
    { "@type": "Thing", name: "NES classics" }
  ],
  hasPart: episodes.map((episode) => buildPodcastEpisodeSchema(episode))
};

const podcastEpisodeSchemaTemplate = {
  "@context": "https://schema.org",
  ...buildPodcastEpisodeSchema(featuredEpisode)
};
---

<BaseLayout
  title={podcastMetaTitle}
  description={podcastMetaDescription}
  canonicalUrl={podcastPageUrl}
  ogType="website"
  ogTitle={podcastMetaTitle}
  ogDescription={podcastMetaDescription}
  ogImage={featuredImageUrl}
  jsonLd={[podcastSeriesSchema, podcastEpisodeSchemaTemplate]}
>
  <SiteHeader brand={siteMeta.title} navItems={navItems} />

  <main class="mx-auto flex w-full max-w-6xl flex-col gap-16 px-5 pb-20 pt-8 md:px-8 md:pt-10">
    <section class="hero-panel">
      <div class="hero-grid">
        <div>
          <p class="section-kicker">Podcast Hub</p>
          <h1 class="hero-title">{podcastFeature.title}</h1>
          <p class="hero-copy">{podcastFeature.description}</p>
          <div class="hero-cta-row">
            <a href="#latest-episodes" class="accent-button">Jump to Episodes</a>
            <a href="/" class="ghost-button">Back to Home</a>
          </div>
        </div>

        <div class="hero-art-wrap">
          <img
            src={featuredEpisode.thumbnail}
            alt="The Overwhelmed Gamer podcast cover art"
            class="hero-art-main"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section id="latest-episodes" class="space-y-8">
      <div class="space-y-2">
        <p class="section-kicker">Episode Grid</p>
        <h2 class="font-display text-3xl text-[var(--color-text)] sm:text-4xl">Retro Gaming Podcast Episodes</h2>
      </div>

      <div class="grid items-start gap-4 lg:grid-cols-[1.1fr_0.9fr]">
        <article class="media-card podcast-index-featured-card">
          <div class="media-thumbnail-wrap">
            <a href={featuredEpisode.externalLink} aria-label={`Open ${featuredEpisode.title}`}>
              <img
                src={featuredEpisode.thumbnail}
                alt={featuredThumbnailAlt}
                class="media-thumbnail"
                loading="lazy"
                decoding="async"
              />
            </a>
            <span class="media-label">Featured</span>
          </div>

          <div class="space-y-3">
            <a href={featuredEpisode.externalLink} class="block" aria-label={`Open ${featuredEpisode.title}`}>
              <h3 class="font-display text-2xl text-[var(--color-text)] sm:text-3xl">{featuredEpisode.title}</h3>
            </a>
            <p class="text-sm leading-relaxed text-[var(--color-muted)]">
              {featuredEpisode.summary ?? featuredEpisode.description}
            </p>
            {featuredEpisode.notesHtml ? (
              <details class="podcast-index-notes">
                <summary class="tool-cta inline-flex cursor-pointer">Read Episode Notes</summary>
                <div class="episode-notes mt-3" set:html={featuredEpisode.notesHtml}></div>
              </details>
            ) : null}
            <p class="text-xs uppercase tracking-[0.13em] text-[var(--color-muted)]">{featuredEpisode.date} • {featuredEpisode.platform}</p>
          </div>
        </article>

        <div class="feature-card podcast-listen-panel">
          <div class="space-y-3">
            <span class="chip">Listen Anywhere</span>
            <h2 class="font-display text-2xl text-[var(--color-text)]">Listen Anywhere</h2>
            <p class="text-sm leading-relaxed text-[var(--color-muted)]">
              Open the full episode page or subscribe on your favorite platform.
            </p>
          </div>

          <a href={featuredEpisode.externalLink} class="accent-button self-start">Open Episode Page</a>

          <PodcastListenLinks episode={featuredEpisode} bare />
        </div>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {episodes.slice(1).map((episode) => <PodcastEpisodeCard item={episode} />)}
      </div>
    </section>
  </main>

  <SiteFooter brand={siteMeta.title} />
</BaseLayout>

<style>
  .podcast-index-featured-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .podcast-index-featured-card .media-thumbnail-wrap {
    margin-bottom: 0;
  }

  .podcast-listen-panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .podcast-index-notes summary::-webkit-details-marker {
    display: none;
  }

  .episode-notes p {
    margin: 0.85rem 0;
    line-height: 1.72;
    color: var(--color-muted);
  }

  .episode-notes a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    overflow-wrap: anywhere;
  }
</style>
