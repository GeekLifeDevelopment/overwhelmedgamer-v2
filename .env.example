YOUTUBE_API_KEY=replace-with-youtube-api-key
YOUTUBE_CHANNEL_ID=UCU5yHwDYrLbAPI2UuAOV0lw

# Latest channel videos: choose either a single comma-separated variable
YOUTUBE_LATEST_VIDEOS_PLAYLIST_IDS=playlist-id-1,playlist-id-2,playlist-id-3

# Or provide the three playlists individually
YOUTUBE_GAMING_DISCUSSION_PLAYLIST_ID=playlist-id-1
YOUTUBE_LATE_TO_THE_GAME_PLAYLIST_ID=playlist-id-2
YOUTUBE_HOMEBREW_INDIE_HEROS_PLAYLIST_ID=playlist-id-3

# If latest playlist IDs are omitted, the app will attempt discovery by playlist name using YOUTUBE_CHANNEL_ID.
# Legacy single-playlist variable is no longer used by the latest videos section.
YOUTUBE_REVIEWS_PLAYLIST_ID=PLvh4T4J_a6TZTSExR4TPfLp_3E-keOxeN

# Optional podcast platform links used on episode pages
PODCAST_FEED_URL=https://api.riverside.com/hosting/Rspwhe3G.rss
PODCAST_SPOTIFY_URL=https://open.spotify.com/show/2QjYq0AzmWPuqLz6kTZIht
PODCAST_APPLE_URL=https://podcasts.apple.com/us/podcast/overwhelmed-gamer/id1752872724
PODCAST_YOUTUBE_URL=https://www.youtube.com/playlist?list=PLvh4T4J_a6TZslLga2zYPws0iRS8tBk-L

# Fourthwall Storefront API token
# Add this in Netlify: Site config → Environment variables → FOURTHWALL_STOREFRONT_TOKEN
FOURTHWALL_STOREFRONT_TOKEN=replace-with-fourthwall-storefront-token
